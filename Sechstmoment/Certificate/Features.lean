def aggregate (f : Feature) : List Int :=
  (List.range 5).map fun k => sum (certificate.map fun d =>
    if d.typ = f.typ ∧ d.A = f.A ∧ d.B = f.B then
      d.coefficient * coef (cheb d.degree) k else 0)

set_option maxRecDepth 100000
set_option maxHeartbeats 0

theorem features_length : features.length = 178 := by decide +kernel

theorem features_keys_nodup :
    (features.map fun f => (f.typ,f.A,f.B)).Nodup := by decide +kernel

theorem features_aggregate_correct : ∀ f ∈ features, aggregate f = f.poly := by decide +kernel

theorem features_cover_certificate : ∀ d ∈ certificate,
    features.any (fun f => decide (f.typ = d.typ ∧ f.A = d.A ∧ f.B = d.B)) = true := by decide +kernel

end Sechstmoment.Finite
